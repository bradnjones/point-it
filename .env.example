# Copy to .env and fill in. All values below are the defaults used if unset.

# --- Server ---
PORT=3001
# Origin allowed to connect over CORS/websocket in development (Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# --- Database (STORY-002) ---
# Path to the SQLite file, created automatically on first run. If unset, it
# defaults to server/data/point-it.db (deterministic regardless of where the
# process is launched). A relative path here is resolved against the current
# working directory; an absolute path is used as-is.
# DATABASE_PATH=./data/point-it.db

# --- GitLab integration (STORY-014 / STORY-015) ---
# Personal access token from gitlab.com.
#   read_api  - required to import work items
#   api       - additionally required for write-back (STORY-016, stretch)
GITLAB_TOKEN=
GITLAB_GRAPHQL_URL=https://gitlab.com/api/graphql
# Full path of the project to import from, e.g. my-group/my-project
GITLAB_PROJECT_PATH=
